{
  "name": "elementor-live",
  "version": "0.1.0",
  "description": "Agentic IDE bridge for WordPress/Elementor: an MCP server that drives the live Elementor editor tab via CDP ($e.run), with ghost cursor, vision and user-activity stream.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "elementor-live": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "e2e": "tsx e2e/run.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "playwright-core": "^1.50.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
